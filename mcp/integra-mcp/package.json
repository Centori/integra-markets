{
  "name": "@integra/mcp",
  "version": "0.2.0",
  "description": "Integra Markets MCP server \u2014 commodity sentiment, prediction-market divergence, and narrative intelligence. stdio for Claude Desktop/Code; Streamable HTTP for remote clients.",
  "license": "MIT",
  "author": "Integra Markets",
  "homepage": "https://integramarkets.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Centori/integra-markets.git",
    "directory": "mcp/integra-mcp"
  },
  "keywords": [
    "mcp",
    "claude",
    "integra",
    "commodities",
    "sentiment",
    "prediction-markets"
  ],
  "type": "module",
  "bin": {
    "integra-mcp": "dist/index.js",
    "integra-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
