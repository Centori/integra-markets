{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Integra Markets API",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://integramarkets.app"
  },
  "colors": {
    "primary": "#4ECCA3",
    "light": "#7FE6C0",
    "dark": "#2BAE7E"
